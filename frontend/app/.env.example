# Copy to .env for local development. The frontend's only .env-loaded
# variable is VITE_API_BASE_URL (read via import.meta.env in
# src/lib/utils.ts getApiBaseUrl()).

# Base URL of the backend API. Leave empty for the default: same-origin
# (the backend serves the built UI) in production, and the Vite dev
# proxy (/api -> http://localhost:8000) in development.
# Set this only when the frontend is served from a separate origin or
# by a mobile client that cannot rely on same origin or the dev proxy.
# getApiBaseUrl() trims whitespace, strips trailing slashes, and strips
# one trailing /api/v1 segment, so both of these are equivalent:
#   VITE_API_BASE_URL=https://api.example.com
#   VITE_API_BASE_URL=https://api.example.com/api/v1
VITE_API_BASE_URL=
